<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #eef1f6;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            color: #1f2937;
        }

        .wrapper {
            width: 100%;
            padding: 40px 16px;
        }

        .container {
            max-width: 480px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(17, 24, 39, 0.08);
        }

        .header {
            background: linear-gradient(135deg, #2563eb, #1e40af);
            padding: 28px 30px;
            text-align: center;
        }

        .header .brand {
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            opacity: 0.9;
        }

        .lock-badge {
            width: 56px;
            height: 56px;
            margin: 0 auto 4px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            line-height: 1;
            text-align: center;
        }

        .lock-badge span {
            display: block;
            transform: translateY(1px);
        }

        .body {
            padding: 36px 32px 32px;
        }

        h2 {
            margin: 0 0 12px;
            font-size: 21px;
            font-weight: 700;
            color: #111827;
            text-align: center;
        }

        p {
            font-size: 14.5px;
            line-height: 1.65;
            color: #4b5563;
            margin: 0 0 8px;
            text-align: center;
        }

        .otp-box {
            margin: 26px auto 8px;
            text-align: center;
        }

        .otp {
            display: inline-block;
            padding: 16px 30px;
            background: #f0f5ff;
            border: 1px dashed #93b4fb;
            color: #1d4ed8;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: 10px;
            border-radius: 10px;
        }

        .expiry {
            display: inline-block;
            margin: 20px auto 0;
            font-size: 13px;
            color: #b45309;
            background: #fffbeb;
            border: 1px solid #fde68a;
            padding: 8px 16px;
            border-radius: 20px;
            text-align: center;
        }

        .expiry-wrap {
            text-align: center;
        }

        .divider {
            height: 1px;
            background: #eef0f3;
            margin: 30px 0 20px;
        }

        .note {
            font-size: 13px;
            color: #9ca3af;
            text-align: center;
        }

        .footer {
            padding: 20px 32px 28px;
            text-align: center;
            font-size: 12px;
            color: #9ca3af;
            background: #fafbfc;
            border-top: 1px solid #f0f0f0;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <div class="lock-badge"><span>🔒</span></div>
                <div class="brand">MediCore Healthcare</div>
            </div>
            <div class="body">
                <h2>Password Reset Request</h2>
                <p>Hello <%= name %>, we received a request to reset the password on your account.</p>
                <p>Enter the one-time code below to continue:</p>

                <div class="otp-box">
                    <span class="otp">
                        <%= otp %>
                    </span>
                </div>

                <div class="expiry-wrap">
                    <span class="expiry">⏱ Expires in <%= expirationMinutes %> minutes</span>
                </div>

                <div class="divider"></div>
                <p class="note">If you did not request this, you can safely ignore this email — your password will
                    remain unchanged.</p>
            </div>
            <div class="footer">
                &copy; <%= new Date().getFullYear() %> MediCore Healthcare System. All rights reserved.
            </div>
        </div>
    </div>
</body>

</html>